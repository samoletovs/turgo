# ─── DATABASE ────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace?schema=public"

# ─── AUTH ────────────────────────────────────────────────
NEXTAUTH_SECRET="your-secret-change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── AI ─────────────────────────────────────────────────
AI_PROVIDER="github"  # github | azure | mock

# GitHub Models
GITHUB_TOKEN=""
GITHUB_MODELS_ENDPOINT="https://models.inference.ai.azure.com"
GITHUB_MODELS_MODEL="gpt-4o-mini"

# Azure OpenAI (alternative)
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_KEY=""
AZURE_OPENAI_DEPLOYMENT=""

# ─── SCRAPER ────────────────────────────────────────────
SSLV_SCRAPING_ENABLED="false"
SSLV_BASE_URL="https://www.ss.lv"
SSLV_REQUEST_DELAY_MS="2000"

# ─── SEARCH ─────────────────────────────────────────────
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="masterKey_change_in_production"

# ─── REDIS ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── STRIPE ─────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── EMAIL ──────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@marketplace.local"

# ─── APP ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── OBSERVABILITY ──────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=""
